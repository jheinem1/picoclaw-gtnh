#!/usr/bin/env sh
set -eu

API_BASE="${GTNH_WIKI_API_BASE:-https://wiki.gtnewhorizons.com/w/api.php}"
HTML_BASE="${GTNH_WIKI_HTML_BASE:-https://gtnh.miraheze.org/wiki}"
SEARCH_LIMIT="${GTNH_WIKI_SEARCH_LIMIT:-5}"
MAX_CHARS="${GTNH_WIKI_MAX_CHARS:-6000}"
TITLE="${*:-}"

fail() {
  printf '{"ok":false,"error":"%s"}\n' "$(json_escape "$1")"
  exit 1
}

json_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

clean_text() {
  printf '%s' "$1" \
    | sed 's/<[^>]*>//g' \
    | sed 's/&quot;/"/g; s/&amp;/\&/g; s/&lt;/</g; s/&gt;/>/g; s/&#39;/'"'"'/g' \
    | tr '\n\r\t' '   ' \
    | sed 's/[[:space:]][[:space:]]*/ /g; s/^ //; s/ $//'
}

urlencode_title() {
  python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1].replace(" ", "_"), safe="_()"))' "$1"
}

extract_html_text() {
  python3 - "$1" <<'PY'
from html.parser import HTMLParser
import html
import re
import sys

path = sys.argv[1]
with open(path, "r", encoding="utf-8", errors="replace") as f:
    raw = f.read()

class ContentTextParser(HTMLParser):
    def __init__(self):
        super().__init__()
        self.in_content = False
        self.depth = 0
        self.skip = 0
        self.parts = []

    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)
        if tag == "div" and attrs.get("id") == "mw-content-text":
            self.in_content = True
            self.depth = 1
            return
        if not self.in_content:
            return
        self.depth += 1
        classes = attrs.get("class", "")
        if tag in {"script", "style", "table"} or "navbox" in classes or "toc" in classes:
            self.skip += 1
        if self.skip == 0 and tag in {"h1", "h2", "h3", "p", "li", "br"}:
            self.parts.append("\n")

    def handle_endtag(self, tag):
        if not self.in_content:
            return
        if self.skip > 0 and tag in {"script", "style", "table", "div"}:
            self.skip -= 1
        self.depth -= 1
        if self.depth <= 0:
            self.in_content = False

    def handle_data(self, data):
        if self.in_content and self.skip == 0:
            self.parts.append(data)

parser = ContentTextParser()
parser.feed(raw)
text = html.unescape(" ".join(parser.parts))
text = re.sub(r"\s+", " ", text).strip()
print(text)
PY
}

[ -n "$TITLE" ] || fail "usage: gtnh_wiki_page <title>"

RAW=""
API_OK=false
if RAW="$(
  curl -fsS --connect-timeout 5 --max-time 20 --get "$API_BASE" \
    --data-urlencode "action=query" \
    --data-urlencode "format=json" \
    --data-urlencode "formatversion=2" \
    --data-urlencode "prop=extracts|info" \
    --data-urlencode "explaintext=1" \
    --data-urlencode "inprop=url" \
    --data-urlencode "redirects=1" \
    --data-urlencode "titles=${TITLE}" \
    --data-urlencode "origin=*" \
    2>/dev/null
)"; then
  API_OK=true
  PAGE_TITLE="$(printf '%s' "$RAW" | jq -r 'first(.query.pages[]? | select(.missing != true and .pageid != null) | .title // empty) // empty')"
  EXTRACT="$(printf '%s' "$RAW" | jq -r 'first(.query.pages[]? | select(.missing != true and .pageid != null) | .extract // empty) // empty')"
  FULLURL="$(printf '%s' "$RAW" | jq -r 'first(.query.pages[]? | select(.missing != true and .pageid != null) | .fullurl // empty) // empty')"
else
  PAGE_TITLE=""
  EXTRACT=""
  FULLURL=""
fi

EXTRACT_CLEAN="$(clean_text "$EXTRACT")"
if [ -z "$EXTRACT_CLEAN" ] && [ "$API_OK" = false ]; then
  PAGE_PATH="$(urlencode_title "$TITLE")"
  HTML_URL="${HTML_BASE%/}/$PAGE_PATH"
  HTML_FILE="$(mktemp)"
  trap 'rm -f "$HTML_FILE"' EXIT
  if curl -fsSL --connect-timeout 5 --max-time 20 "$HTML_URL" -o "$HTML_FILE" 2>/dev/null; then
    PAGE_TITLE="${PAGE_TITLE:-$TITLE}"
    FULLURL="${FULLURL:-$HTML_URL}"
    EXTRACT_CLEAN="$(extract_html_text "$HTML_FILE")"
  fi
fi
if [ -z "$EXTRACT_CLEAN" ]; then
  SEARCH_RAW=""
  if SEARCH_RAW="$(
    curl -fsS --connect-timeout 5 --max-time 20 --get "$API_BASE" \
      --data-urlencode "action=query" \
      --data-urlencode "format=json" \
      --data-urlencode "formatversion=2" \
      --data-urlencode "list=search" \
      --data-urlencode "srsearch=${TITLE}" \
      --data-urlencode "srlimit=${SEARCH_LIMIT}" \
      --data-urlencode "srprop=snippet" \
      --data-urlencode "origin=*" \
      2>/dev/null
  )"; then
    MATCH_COUNT="$(printf '%s' "$SEARCH_RAW" | jq -r '[.query.search[]?] | length')"
    SEARCH_STRATEGY="query"
    if [ "$MATCH_COUNT" -eq 0 ]; then
      BROAD_QUERY="$(python3 -c 'import re,sys; stop={"a","all","an","and","do","for","how","in","is","me","need","of","our","requirements","setup","system","the","to","we","what","with"}; alias={"autocraft":"automation","autocrafting":"automation"}; words=[alias.get(w.lower(),w) for w in re.findall(r"[A-Za-z0-9]+",sys.argv[1]) if w.lower() not in stop][:3]; print(" ".join((w[:5]+"*") if len(w)>6 else w for w in words))' "$TITLE")"
      if [ -n "$BROAD_QUERY" ] && [ "$BROAD_QUERY" != "$TITLE" ]; then
        SEARCH_RAW="$(
          curl -fsS --connect-timeout 5 --max-time 20 --get "$API_BASE" \
            --data-urlencode "action=query" \
            --data-urlencode "format=json" \
            --data-urlencode "formatversion=2" \
            --data-urlencode "list=search" \
            --data-urlencode "srsearch=${BROAD_QUERY}" \
            --data-urlencode "srlimit=${SEARCH_LIMIT}" \
            --data-urlencode "srprop=snippet" \
            --data-urlencode "origin=*" \
            2>/dev/null
        )" || SEARCH_RAW='{}'
        SEARCH_STRATEGY="broadened_terms"
      fi
    fi
    printf '%s' "$SEARCH_RAW" | jq -c \
      --arg query "$TITLE" \
      --arg strategy "$SEARCH_STRATEGY" \
      --arg source "wiki.gtnewhorizons.com/w/api.php" \
      '{ok:true, exact:false, query:$query, strategy:$strategy,
        matches:[.query.search[]? | {
          title:.title,
          url:("https://wiki.gtnewhorizons.com/wiki/" + (.title | gsub(" "; "_"))),
          summary:((.snippet // "") | gsub("<[^>]*>"; "") | gsub("&quot;"; "\"") | gsub("&amp;"; "&") | gsub("&#39;"; "\u0027"))
        }], source:$source}'
    exit 0
  fi
fi

[ -n "$PAGE_TITLE" ] || fail "page not found"
[ -n "$FULLURL" ] || FULLURL="https://wiki.gtnewhorizons.com/wiki/$(printf '%s' "$PAGE_TITLE" | sed 's/ /_/g')"

EXTRACT_CLEAN="$(printf '%s' "$EXTRACT_CLEAN" | cut -c "1-${MAX_CHARS}")"
[ -n "$EXTRACT_CLEAN" ] || fail "empty extract for page: $PAGE_TITLE"

printf '{"ok":true,"exact":true,"query":"%s","title":"%s","url":"%s","summary":"%s","source":"wiki.gtnewhorizons.com/w/api.php"}\n' \
  "$(json_escape "$TITLE")" \
  "$(json_escape "$PAGE_TITLE")" \
  "$(json_escape "$FULLURL")" \
  "$(json_escape "$EXTRACT_CLEAN")"
