#!/usr/bin/env sh
set -eu

BASE="$(cd "$(dirname "$0")" && pwd)"
ITEMS="${GTNH_ITEMS_INDEX:-$BASE/gtnh-data/index/item_index.tsv}"
RECIPES="${GTNH_RECIPES_INDEX:-$BASE/gtnh-data/index/recipe_index.tsv}"
OREDICT="${GTNH_OREDICT_INDEX:-$BASE/gtnh-data/index/oredict_index.tsv}"

fail() {
  printf '{"ok":false,"error":"%s"}\n' "$1"
  exit 1
}

[ -f "$ITEMS" ] || fail "missing index: $ITEMS"
[ -f "$RECIPES" ] || fail "missing index: $RECIPES"

cmd="${1:-}"
shift || true

if [ -n "${GTNH_QUERY_FAST_BIN:-}" ]; then
  FAST_QUERY="$GTNH_QUERY_FAST_BIN"
elif [ -x "$BASE/tools/gtnh_query_fast" ]; then
  FAST_QUERY="$BASE/tools/gtnh_query_fast"
else
  FAST_QUERY="$BASE/tools/gtnh_query_fast.py"
fi
if [ -x "$FAST_QUERY" ]; then
  case "$cmd" in
    find-item|resolve-recipes)
      exec "$FAST_QUERY" "$cmd" "$@"
      ;;
  esac
fi

json_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

file_age_text() {
  path="$1"
  [ -f "$path" ] || { printf 'missing'; return; }
  now="$(date -u +%s)"
  mt="$(stat -c %Y "$path" 2>/dev/null || printf 0)"
  age=$((now - mt))
  [ "$age" -ge 0 ] || age=0
  if [ "$age" -lt 60 ]; then
    printf '%ss old' "$age"
  elif [ "$age" -lt 3600 ]; then
    printf '%sm old' "$((age / 60))"
  elif [ "$age" -lt 172800 ]; then
    printf '%sh old' "$((age / 3600))"
  else
    printf '%sd old' "$((age / 86400))"
  fi
}

freshness_json() {
  printf '"freshness":{"item_index":"%s","recipe_index":"%s","oredict_index":"%s"}' \
    "$(json_escape "$(file_age_text "$ITEMS")")" \
    "$(json_escape "$(file_age_text "$RECIPES")")" \
    "$(json_escape "$(file_age_text "$OREDICT")")"
}

find_item() {
  use_oredict=0
  while [ "$#" -gt 0 ]; do
    case "${1:-}" in
      --oredict|--ore-dict)
        use_oredict=1
        shift
        ;;
      --)
        shift
        break
        ;;
      -*)
        fail "usage: find-item [--oredict] <text>"
        ;;
      *)
        break
        ;;
    esac
  done

  q="${1:-}"
  [ -n "$q" ] || fail "usage: find-item <text>"
  if [ "$use_oredict" = "1" ]; then
    [ -f "$OREDICT" ] || fail "missing ore dict index: $OREDICT (run workspace/tools/build_oredict_index.py after importing a real GTNH ore dict dump)"
    awk -F '\t' -v q="$q" '
      function compact(s, t) {
        t = tolower(s)
        gsub(/[^a-z0-9]+/, "", t)
        return t
      }
      function add_candidate(score, slug, display, reg, name, i, worst, idx) {
        if (seen[slug]) return

        if (count < 20) {
          count++
          idx = count
        } else {
          worst = 1
          for (i = 2; i <= count; i++) {
            if (scores[i] > scores[worst] || (scores[i] == scores[worst] && tolower(displays[i]) > tolower(displays[worst]))) {
              worst = i
            }
          }
          if (score > scores[worst] || (score == scores[worst] && tolower(display) >= tolower(displays[worst]))) {
            return
          }
          delete seen[slugs[worst]]
          idx = worst
        }

        seen[slug] = 1
        scores[idx] = score
        slugs[idx] = slug
        displays[idx] = display
        regs[idx] = reg
        names[idx] = name
      }
      BEGIN {
        want = compact(q)
        count = 0
        best_score = 999999
      }
      NR == 1 { next }
      {
        ore = compact($1)
        score = 999999
        if (ore == want) {
          score = 0
        } else if (want != "" && index(ore, want) > 0) {
          score = 100 + length(ore)
        }
        if (score < 999999) {
          if (score < best_score) best_score = score
          add_candidate(score, $2, $3, $4, $5)
        }
      }
      END {
        for (i = 1; i <= count; i++) ord[i] = i
        for (i = 1; i <= count; i++) {
          for (j = i + 1; j <= count; j++) {
            a = ord[i]
            b = ord[j]
            if (scores[b] < scores[a] || (scores[b] == scores[a] && tolower(displays[b]) < tolower(displays[a]))) {
              t = ord[i]
              ord[i] = ord[j]
              ord[j] = t
            }
          }
        }

        out = 0
        for (i = 1; i <= count; i++) {
          idx = ord[i]
          if (scores[idx] != best_score) continue
          if (out > 0) printf(",")
          printf("{\"slug\":\"%s\",\"display_name\":\"%s\",\"reg_name\":\"%s\",\"name\":\"%s\"}", slugs[idx], displays[idx], regs[idx], names[idx])
          out++
          if (out >= 20) break
        }
        printf("\n")
      }
    ' "$OREDICT" | awk -v query="$(json_escape "$q")" -v freshness="$(freshness_json)" '
      BEGIN { printf("{\"ok\":true,\"query\":\"%s\",\"oredict\":true,\"items\":[", query) }
      { printf("%s", $0) }
      END { printf("],%s}\n", freshness) }
    '
    return
  fi

  ql="$(printf '%s' "$q" | tr '[:upper:]' '[:lower:]')"
  fast_exact_items="$(awk -F '\t' -v q="$ql" '
    function tier_display(s, parts, n, tier, rest, i) {
      n = split(s, parts, " ")
      if (n < 2) return ""
      tier = parts[1]
      if (tier !~ /^(ulv|lv|mv|hv|ev|iv|luv|zpm|uv|uhv|uev|uiv|umv|uxv)$/) return ""
      rest = parts[2]
      for (i = 3; i <= n; i++) rest = rest " " parts[i]
      return rest " (" tier ")"
    }
    BEGIN {
      tq = tier_display(q)
      out = 0
    }
    NR == 1 { next }
    {
      d = tolower($2)
      r = tolower($3)
      n = tolower($4)
      if (d == q || r == q || n == q || (tq != "" && d == tq)) {
        if (out > 0) printf(",")
        printf("{\"slug\":\"%s\",\"display_name\":\"%s\",\"reg_name\":\"%s\",\"name\":\"%s\"}", $1, $2, $3, $4)
        out++
        if (out >= 20) exit
      }
    }
  ' "$ITEMS")"
  if [ -n "$fast_exact_items" ]; then
    printf '{"ok":true,"query":"%s","oredict":false,"items":[%s],%s}\n' "$(json_escape "$q")" "$fast_exact_items" "$(freshness_json)"
    return
  fi

  exact_items="$(awk -F '\t' -v q="$ql" '
    function norm(s, t) {
      t = tolower(s)
      gsub(/§[0-9a-fk-or]/, "", t)
      gsub(/[^a-z0-9]+/, " ", t)
      gsub(/^ +| +$/, "", t)
      gsub(/ +/, " ", t)
      return t
    }
    function alias_tier(display, inner, outer) {
      if (display ~ /\([A-Za-z0-9]+\)/) {
        inner = display
        sub(/^.*\(/, "", inner)
        sub(/\).*$/, "", inner)
        outer = display
        sub(/[[:space:]]*\([^)]+\)[[:space:]]*$/, "", outer)
        return norm(inner " " outer)
      }
      return ""
    }
    BEGIN { qn = norm(q); out = 0 }
    NR == 1 { next }
    {
      d = norm($2)
      a = alias_tier($2)
      r = norm($3)
      n = norm($4)
      if (d == qn || a == qn || r == qn || n == qn) {
        if (out > 0) printf(",")
        printf("{\"slug\":\"%s\",\"display_name\":\"%s\",\"reg_name\":\"%s\",\"name\":\"%s\"}", $1, $2, $3, $4)
        out++
        if (out >= 20) exit
      }
    }
  ' "$ITEMS")"
  if [ -n "$exact_items" ]; then
    printf '{"ok":true,"query":"%s","oredict":false,"items":[%s],%s}\n' "$(json_escape "$q")" "$exact_items" "$(freshness_json)"
    return
  fi

  awk -F '\t' -v q="$ql" '
    function norm(s, t) {
      t = tolower(s)
      gsub(/§[0-9a-fk-or]/, "", t)
      gsub(/[^a-z0-9]+/, " ", t)
      gsub(/^ +| +$/, "", t)
      gsub(/ +/, " ", t)
      return t
    }
    function alias_tier(display, inner, outer) {
      if (display ~ /\([A-Za-z0-9]+\)/) {
        inner = display
        sub(/^.*\(/, "", inner)
        sub(/\).*$/, "", inner)
        outer = display
        sub(/[[:space:]]*\([^)]+\)[[:space:]]*$/, "", outer)
        return norm(inner " " outer)
      }
      return ""
    }
    function add_candidate(score, slug, display, reg, name, i, worst, idx) {
      if (seen[slug]) return

      if (count < 20) {
        count++
        idx = count
      } else {
        worst = 1
        for (i = 2; i <= count; i++) {
          if (scores[i] > scores[worst] || (scores[i] == scores[worst] && tolower(displays[i]) > tolower(displays[worst]))) {
            worst = i
          }
        }
        if (score > scores[worst] || (score == scores[worst] && tolower(display) >= tolower(displays[worst]))) {
          return
        }
        delete seen[slugs[worst]]
        idx = worst
      }

      seen[slug] = 1
      scores[idx] = score
      slugs[idx] = slug
      displays[idx] = display
      regs[idx] = reg
      names[idx] = name
    }
    BEGIN {
      qn = norm(q)
      qtok_n = split(qn, qtok, " ")
      count = 0
    }
    NR == 1 { next }
    {
      d = norm($2)
      a = alias_tier($2)
      r = norm($3)
      n = norm($4)
      all = d " " a " " r " " n
      score = 999999

      if (d == qn || a == qn || r == qn || n == qn) {
        score = 0
      } else if (index(d, qn) > 0 || index(a, qn) > 0 || index(r, qn) > 0 || index(n, qn) > 0) {
        score = 50 + length(d)
      } else {
        hits = 0
        for (i = 1; i <= qtok_n; i++) {
          tok = qtok[i]
          if (length(tok) < 3) continue
          if (index(all, tok) > 0) hits++
        }
        if (hits > 0) score = 200 - (hits * 30) + length(d)
      }

      if (score < 999999) add_candidate(score, $1, $2, $3, $4)
    }
    END {
      for (i = 1; i <= count; i++) ord[i] = i
      for (i = 1; i <= count; i++) {
        for (j = i + 1; j <= count; j++) {
          a = ord[i]
          b = ord[j]
          if (scores[b] < scores[a] || (scores[b] == scores[a] && tolower(displays[b]) < tolower(displays[a]))) {
            t = ord[i]
            ord[i] = ord[j]
            ord[j] = t
          }
        }
      }

      out = 0
      for (i = 1; i <= count; i++) {
        idx = ord[i]
        if (out > 0) printf(",")
        printf("{\"slug\":\"%s\",\"display_name\":\"%s\",\"reg_name\":\"%s\",\"name\":\"%s\"}", slugs[idx], displays[idx], regs[idx], names[idx])
        out++
        if (out >= 20) break
      }
      printf("\n")
    }
  ' "$ITEMS" | awk -v query="$(json_escape "$q")" -v freshness="$(freshness_json)" '
    BEGIN { printf("{\"ok\":true,\"query\":\"%s\",\"oredict\":false,\"items\":[", query) }
    { printf("%s", $0) }
    END { printf("],%s}\n", freshness) }
  '
}
resolve_recipes() {
  q="${1:-}"
  [ -n "$q" ] || fail "usage: resolve-recipes <text>"
  ql="$(printf '%s' "$q" | tr '[:upper:]' '[:lower:]')"

  slug="$(awk -F '\t' -v q="$ql" '
    function tier_display(s, parts, n, tier, rest, i) {
      n = split(s, parts, " ")
      if (n < 2) return ""
      tier = parts[1]
      if (tier !~ /^(ulv|lv|mv|hv|ev|iv|luv|zpm|uv|uhv|uev|uiv|umv|uxv)$/) return ""
      rest = parts[2]
      for (i = 3; i <= n; i++) rest = rest " " parts[i]
      return rest " (" tier ")"
    }
    BEGIN { tq = tier_display(q) }
    NR == 1 { next }
    {
      d = tolower($2)
      r = tolower($3)
      n = tolower($4)
      if (d == q || r == q || n == q || (tq != "" && d == tq)) {
        print $1
        exit
      }
    }
  ' "$ITEMS")"

  if [ -z "$slug" ]; then
    slug="$(awk -F '\t' -v q="$ql" '
    function norm(s, t) {
      t = tolower(s)
      gsub(/§[0-9a-fk-or]/, "", t)
      gsub(/[^a-z0-9]+/, " ", t)
      gsub(/^ +| +$/, "", t)
      gsub(/ +/, " ", t)
      return t
    }
    function alias_tier(display, inner, outer) {
      if (display ~ /\([A-Za-z0-9]+\)/) {
        inner = display
        sub(/^.*\(/, "", inner)
        sub(/\).*$/, "", inner)
        outer = display
        sub(/[[:space:]]*\([^)]+\)[[:space:]]*$/, "", outer)
        return norm(inner " " outer)
      }
      return ""
    }
    BEGIN { qn = norm(q) }
    NR == 1 { next }
    {
      d = norm($2)
      a = alias_tier($2)
      r = norm($3)
      n = norm($4)
      if (d == qn || a == qn || r == qn || n == qn) {
        print $1
        exit
      }
      if (d == qn " ingot" || n == qn " ingot") {
        fallback = $1
      }
    }
    END {
      if (fallback != "") print fallback
    }
  ' "$ITEMS")"
  fi

  if [ -z "$slug" ]; then
    slug="$(awk -F '\t' -v q="$ql" '
    function norm(s, t) {
      t = tolower(s)
      gsub(/§[0-9a-fk-or]/, "", t)
      gsub(/[^a-z0-9]+/, " ", t)
      gsub(/^ +| +$/, "", t)
      gsub(/ +/, " ", t)
      return t
    }
    function alias_tier(display, inner, outer) {
      if (display ~ /\([A-Za-z0-9]+\)/) {
        inner = display
        sub(/^.*\(/, "", inner)
        sub(/\).*$/, "", inner)
        outer = display
        sub(/[[:space:]]*\([^)]+\)[[:space:]]*$/, "", outer)
        return norm(inner " " outer)
      }
      return ""
    }
    BEGIN {
      best = 999999
      qn = norm(q)
      qtok_n = split(qn, qtok, " ")
    }
    NR == 1 { next }
    {
      d = norm($2)
      a = alias_tier($2)
      r = norm($3)
      n = norm($4)
      all = d " " a " " r " " n
      score = 999999
      if (d == qn || a == qn || r == qn || n == qn) {
        score = 0
      } else if (d == qn " ingot" || n == qn " ingot") {
        score = 1
      } else if (index(d, qn) > 0 || index(a, qn) > 0 || index(r, qn) > 0 || index(n, qn) > 0) {
        score = 50 + length(d)
      } else {
        hits = 0
        for (i = 1; i <= qtok_n; i++) {
          tok = qtok[i]
          if (length(tok) < 3) { continue }
          if (index(all, tok) > 0) {
            hits++
          }
        }
        if (hits > 0) {
          score = 500 - (hits * 40) + length(d)
        }
      }
      if (score < best) {
        best = score
        slug = $1
      }
    }
    END {
      if (best < 999999) {
        print slug
      }
    }
  ' "$ITEMS")"
  fi

  [ -n "$slug" ] || fail "item not found"

  grep -F "$slug" "$RECIPES" | awk -F '\t' -v s="$slug" '
    BEGIN { out = 0 }
    ($1 == s || $3 == s) {
      if (out > 0) { printf(",") }
      printf("{\"query_slug\":\"%s\",\"query_name\":\"%s\",\"out_slug\":\"%s\",\"out_name\":\"%s\",\"handler\":\"%s\",\"tab\":\"%s\",\"ingredients\":\"%s\"}", $1, $2, $3, $4, $5, $6, $7)
      out++
      if (out >= 30) { exit }
    }
    END { printf("\n") }
  ' "$RECIPES" | awk -v query="$(json_escape "$q")" -v slug="$(json_escape "$slug")" -v freshness="$(freshness_json)" '
    BEGIN { printf("{\"ok\":true,\"query\":\"%s\",\"slug\":\"%s\",\"recipes\":[", query, slug) }
    { printf("%s", $0) }
    END { printf("],\"matched_items\":[{\"slug\":\"%s\"}],\"confidence\":\"single-best\",\"sources\":[\"gtnh-data/index/item_index.tsv\",\"gtnh-data/index/recipe_index.tsv\"],%s}\n", slug, freshness) }
  '
}

search_recipes() {
  q="${1:-}"
  [ -n "$q" ] || fail "usage: search-recipes <text>"
  ql="$(printf '%s' "$q" | tr '[:upper:]' '[:lower:]')"

  cand="$(mktemp)"
  rec="$(mktemp)"
  trap 'rm -f "$cand" "$rec"' EXIT

  awk -F '\t' -v q="$ql" '
    function norm(s, t) {
      t = tolower(s)
      gsub(/§[0-9a-fk-or]/, "", t)
      gsub(/[^a-z0-9]+/, " ", t)
      gsub(/^ +| +$/, "", t)
      gsub(/ +/, " ", t)
      return t
    }
    function alias_tier(display, inner, outer) {
      if (display ~ /\([A-Za-z0-9]+\)/) {
        inner = display
        sub(/^.*\(/, "", inner)
        sub(/\).*$/, "", inner)
        outer = display
        sub(/[[:space:]]*\([^)]+\)[[:space:]]*$/, "", outer)
        return norm(inner " " outer)
      }
      return ""
    }
    BEGIN {
      qn = norm(q)
      qtok_n = split(qn, qtok, " ")
    }
    NR == 1 { next }
    {
      d = norm($2)
      a = alias_tier($2)
      r = norm($3)
      n = norm($4)
      all = d " " a " " r " " n
      score = 999999
      if (d == qn || a == qn || r == qn || n == qn) {
        score = 0
      } else if (d == qn " ingot" || n == qn " ingot") {
        score = 1
      } else if (index(d, qn) > 0 || index(a, qn) > 0 || index(r, qn) > 0 || index(n, qn) > 0) {
        score = 50 + length(d)
      } else {
        hits = 0
        for (i = 1; i <= qtok_n; i++) {
          tok = qtok[i]
          if (length(tok) < 3) { continue }
          if (index(all, tok) > 0) {
            hits++
          }
        }
        if (hits > 0) {
          score = 500 - (hits * 40) + length(d)
        }
      }
      if (score < 999999) {
        printf("%d\t%s\t%s\n", score, $1, $2)
      }
    }
  ' "$ITEMS" | sort -t "$(printf '\t')" -k1,1n -k3,3 | awk -F '\t' '
    !seen[$2]++ {
      print $2 "\t" $3
      c++
      if (c >= 20) {
        exit
      }
    }
  ' > "$cand"

  if [ ! -s "$cand" ]; then
    fail "item not found"
  fi

  awk -F '\t' '
    NR == FNR {
      cand[$1] = $2
      next
    }
    FNR == 1 { next }
    {
      hit1 = ($1 in cand)
      hit3 = ($3 in cand)
      if (!(hit1 || hit3)) {
        next
      }
      slug = $1
      if (!hit1) {
        slug = $3
      }
      printf("%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", slug, cand[slug], $1, $2, $3, $4, $5, $6, $7)
    }
  ' "$cand" "$RECIPES" > "$rec"

  printf '{"ok":true,"query":"%s","matched_items":[' "$(json_escape "$q")"
  first=1
  while IFS="$(printf '\t')" read -r slug dname; do
    [ -n "$slug" ] || continue
    if [ "$first" -eq 0 ]; then
      printf ','
    fi
    first=0
    printf '{"slug":"%s","display_name":"%s"}' "$(json_escape "$slug")" "$(json_escape "$dname")"
  done < "$cand"

  printf '],"recipes":['
  awk -F '\t' '
    function esc(s) {
      gsub(/\\/, "\\\\", s)
      gsub(/"/, "\\\"", s)
      gsub(/\r|\n|\t/, " ", s)
      return s
    }
    NF >= 9 {
      if (count > 0) printf(",")
      printf("{\"match_slug\":\"%s\",\"match_name\":\"%s\",\"query_slug\":\"%s\",\"query_name\":\"%s\",\"out_slug\":\"%s\",\"out_name\":\"%s\",\"handler\":\"%s\",\"tab\":\"%s\",\"ingredients\":\"%s\"}",
        esc($1), esc($2), esc($3), esc($4), esc($5), esc($6), esc($7), esc($8), esc($9))
      count++
      if (count >= 80) exit
    }
  ' "$rec"

  printf '],"confidence":"candidate-search","sources":["gtnh-data/index/item_index.tsv","gtnh-data/index/recipe_index.tsv"],%s}\n' "$(freshness_json)"
}

item() {
  slug="${1:-}"
  [ -n "$slug" ] || fail "usage: item <slug>"
  awk -F '\t' -v s="$slug" '
    NR == 1 { next }
    $1 == s {
      printf("{\"ok\":true,\"item\":{\"slug\":\"%s\",\"display_name\":\"%s\",\"reg_name\":\"%s\",\"name\":\"%s\"},\"source\":\"gtnh-data/index/item_index.tsv\"}\n", $1, $2, $3, $4)
      found = 1
      exit
    }
    END {
      if (!found) {
        printf("{\"ok\":false,\"error\":\"item not found\",\"slug\":\"%s\"}\n", s)
      }
    }
  ' "$ITEMS"
}

case "$cmd" in
  find-item)
    find_item "$@"
    ;;
  resolve-recipes)
    resolve_recipes "$@"
    ;;
  search-recipes)
    search_recipes "$@"
    ;;
  item)
    item "$@"
    ;;
  *)
    fail "unknown command: $cmd (use: find-item, resolve-recipes, search-recipes, item)"
    ;;
esac
