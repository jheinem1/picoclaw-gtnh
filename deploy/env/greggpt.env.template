# Copy this to deploy/env/greggpt.env and fill real values.
# This file is consumed by podman-compose.

# Discord bot runtime settings
GREGGPT_DISCORD_ENABLED=true
DISCORD_BOT_TOKEN=REPLACE_WITH_DISCORD_BOT_TOKEN
KANBAN_DISCORD_TOKEN=REPLACE_WITH_DISCORD_BOT_TOKEN
GREGGPT_DISCORD_MENTIONS_ENABLED=true
GREGGPT_DISCORD_PROGRESS_ENABLED=true
GREGGPT_DISCORD_ALLOW_FROM=1329363718974214216
# Fail closed when the allowlist is empty. Set true only for an intentionally public bot.
GREGGPT_DISCORD_ALLOW_ALL=false

# Minecraft chat progress settings. Commentary is permanent in chat, so each
# update is reduced to one line and the relay caps updates per request.
GREGGPT_MINECRAFT_PROGRESS_ENABLED=true
GREGGPT_MINECRAFT_PROGRESS_MAX_UPDATES=3
GREGGPT_MINECRAFT_STEERING_POLL_SECONDS=2

# GregGPT runtime
GREGGPT_MODEL=gpt-5.6-terra
GREGGPT_REASONING_EFFORT=high
GREGGPT_AUTH_FILE=/root/.greggpt/auth.json
GREGGPT_WORKSPACE=/root/.greggpt/workspace
GREGGPT_AGENT_TIMEOUT_SECONDS=300
GREGGPT_TIMEOUT_SUMMARY_SECONDS=25
GREGGPT_MAX_TOOL_CALLS=500

# Unified SQLite chat history and FTS recall.
# v1 uses local SQLite FTS only; true vector embeddings and external vector DBs are deferred.
GREGGPT_HISTORY_ENABLED=true
GREGGPT_HISTORY_PATH=state/greggpt_history.sqlite
# History uses WAL mode and a 5-second SQLite busy timeout for cross-service writes.
GREGGPT_HISTORY_MAX_MESSAGES=20
GREGGPT_RECALLED_CONTEXT_MAX_ITEMS=12
GREGGPT_RECALLED_CONTEXT_MAX_BYTES=5000

GREGGPT_MEMORY_ENABLED=false
GREGGPT_MEMORY_PATH=state/greggpt_memory.json
GREGGPT_MEMORY_MAX_INJECTED_BYTES=3000
GREGGPT_MEMORY_MAX_INJECTED_ITEMS=8
# Optional default memory TTL; unset or 0 means memories do not expire by default.
# GREGGPT_MEMORY_DEFAULT_TTL_SECONDS=2592000

# Deterministic Discord task-board sync service
KANBAN_ENABLED=false
KANBAN_CHANNEL_ID=1477539994825392128
KANBAN_TITLE=GTNH Kanban Board
KANBAN_MAX_ITEMS_PER_COLUMN=15
KANBAN_POLL_INTERVAL_SECONDS=10
KANBAN_PIN_MESSAGE=true
KANBAN_IN_PROGRESS_ENABLED=false
KANBAN_IN_PROGRESS_CHANNEL_ID=1479648899575844974
KANBAN_IN_PROGRESS_MAX_UPDATES=8

# Deterministic inventory/chest index sync service
INVENTORY_SYNC_ENABLED=false
INVENTORY_WORKDIR=/root/.greggpt/workspace
INVENTORY_STATE_FILE=/var/lib/inventory-sync/state.json
INVENTORY_PLAYERS_INTERVAL_SECONDS=1800
INVENTORY_CHESTS_INTERVAL_SECONDS=21600
INVENTORY_ME_INTERVAL_SECONDS=1800
# Keep this longer than INVENTORY_ME_INTERVAL_SECONDS so a healthy export does
# not alternate between fresh and stale while waiting for its next poll.
INVENTORY_ME_STALE_AFTER_SECONDS=3600
INVENTORY_ME_EXPORT_PATHS=world/greggpt/me_index.json,world/picoclaw/me_index.json
INVENTORY_QUESTS_INTERVAL_SECONDS=1800
INVENTORY_QUEST_PARTY_NAME=Noob Squad
INVENTORY_BLOCK_INVENTORIES_INTERVAL_SECONDS=300
INVENTORY_BLOCK_INVENTORIES_STALE_AFTER_SECONDS=900
INVENTORY_BLOCK_INVENTORY_EXPORT_PATHS=world/picoclaw/block_inventories.json,world/greggpt/block_inventories.json
INVENTORY_BLOCKS_INTERVAL_SECONDS=86400
INVENTORY_MAX_RESULTS=100
INVENTORY_DEFAULT_LIMIT=20
# Region files can be several MiB and the DatHost file endpoint is sometimes
# slow. This timeout applies per retry, not to the whole scan.
INVENTORY_HTTP_TIMEOUT_SECONDS=120
INVENTORY_SCAN_DIMS=0,-1,1,183
# 0 means scan every discovered region. A positive value is a hard completeness
# limit: scans above it fail and retain the previous snapshot rather than publish partial data as fresh.
INVENTORY_MAX_REGION_FILES_PER_RUN=0
# Optional chest scan bounds: dim,min_x,min_z,max_x,max_z
INVENTORY_CHEST_BOUNDS=
# Placed block indexing is disabled unless bounded or allowlisted.
# Bounds format: dim,min_x,min_y,min_z,max_x,max_y,max_z
INVENTORY_BLOCK_BOUNDS=
# Numeric block id/meta allowlist, comma-separated, for example: 300:5,4097:0
INVENTORY_BLOCK_ALLOWLIST=
# Optional TSV registry: id<TAB>meta<TAB>registry_name<TAB>display_name
GTNH_BLOCK_REGISTRY=/root/.greggpt/workspace/gtnh-data/index/block_registry.tsv
