# Copy this to deploy/env/greggpt.env and fill real values.
# This file is consumed by podman-compose.

# Discord bot runtime settings
GREGGPT_DISCORD_ENABLED=true
DISCORD_BOT_TOKEN=REPLACE_WITH_DISCORD_BOT_TOKEN
KANBAN_DISCORD_TOKEN=REPLACE_WITH_DISCORD_BOT_TOKEN
GREGGPT_DISCORD_MENTIONS_ENABLED=true
GREGGPT_DISCORD_ALLOW_FROM=1329363718974214216

# Optional: expose reasoning messages to a separate Discord channel
# GREGGPT_DISCORD_REASONING_CHANNEL_ID=

# GregGPT runtime
GREGGPT_MODEL=gpt-5.3-codex
GREGGPT_AUTH_FILE=/root/.greggpt/auth.json
GREGGPT_WORKSPACE=/root/.greggpt/workspace
GREGGPT_AGENT_TIMEOUT_SECONDS=60
GREGGPT_MAX_TOOL_CALLS=8
GREGGPT_MEMORY_ENABLED=false
GREGGPT_MEMORY_PATH=state/greggpt_memory.json
GREGGPT_MEMORY_MAX_INJECTED_BYTES=3000
GREGGPT_MEMORY_MAX_INJECTED_ITEMS=8
# Optional default memory TTL; unset or 0 means memories do not expire by default.
# GREGGPT_MEMORY_DEFAULT_TTL_SECONDS=2592000

# Deterministic Discord task-board sync service
KANBAN_ENABLED=false
KANBAN_CHANNEL_ID=1477539994825392128
KANBAN_TITLE=GTNH Kanban Board
KANBAN_MAX_ITEMS_PER_COLUMN=15
KANBAN_POLL_INTERVAL_SECONDS=10
KANBAN_PIN_MESSAGE=true
KANBAN_IN_PROGRESS_ENABLED=false
KANBAN_IN_PROGRESS_CHANNEL_ID=1479648899575844974
KANBAN_IN_PROGRESS_MAX_UPDATES=8

# Deterministic inventory/chest index sync service
INVENTORY_SYNC_ENABLED=false
INVENTORY_WORKDIR=/root/.greggpt/workspace
INVENTORY_STATE_FILE=/var/lib/inventory-sync/state.json
INVENTORY_PLAYERS_INTERVAL_SECONDS=1800
INVENTORY_CHESTS_INTERVAL_SECONDS=21600
INVENTORY_ME_INTERVAL_SECONDS=1800
INVENTORY_BLOCKS_INTERVAL_SECONDS=86400
INVENTORY_MAX_RESULTS=100
INVENTORY_DEFAULT_LIMIT=20
INVENTORY_HTTP_TIMEOUT_SECONDS=20
INVENTORY_SCAN_DIMS=0,-1,1
INVENTORY_MAX_REGION_FILES_PER_RUN=64
# Optional chest scan bounds: dim,min_x,min_z,max_x,max_z
INVENTORY_CHEST_BOUNDS=
# Placed block indexing is disabled unless bounded or allowlisted.
# Bounds format: dim,min_x,min_y,min_z,max_x,max_y,max_z
INVENTORY_BLOCK_BOUNDS=
# Numeric block id/meta allowlist, comma-separated, for example: 300:5,4097:0
INVENTORY_BLOCK_ALLOWLIST=
# Optional TSV registry: id<TAB>meta<TAB>registry_name<TAB>display_name
GTNH_BLOCK_REGISTRY=/root/.greggpt/workspace/gtnh-data/index/block_registry.tsv
