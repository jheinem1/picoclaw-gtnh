FROM docker.io/alpine:3.24
COPY relay/prebuilt/mc-relay /usr/local/bin/mc-relay
COPY relay/prebuilt/gtnh_inventory_query /usr/local/bin/gtnh_inventory_query
COPY relay/prebuilt/gtnh_quest_query /usr/local/bin/gtnh_quest_query
RUN apk add --no-cache ca-certificates jq curl python3 flock
RUN mkdir -p /var/lib/mc-relay /root/.greggpt/workspace
ENV GREGGPT_WORKSPACE=/root/.greggpt/workspace
ENTRYPOINT ["/usr/local/bin/mc-relay"]
