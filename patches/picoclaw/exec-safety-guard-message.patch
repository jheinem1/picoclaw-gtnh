+
+func TestShellTool_CustomDenyPatternMessageIncludesMatchedToken(t *testing.T) {
+	cfg := &config.Config{
+		Tools: config.ToolsConfig{
+			Exec: config.ExecConfig{
+				EnableDenyPatterns: true,
+				CustomDenyPatterns: []string{`&&|\|\||;|\|`},
+			},
+		},
+	}
+
+	tool, err := NewExecToolWithConfig("", false, cfg)
+	if err != nil {
+		t.Fatalf("unable to configure exec tool: %s", err)
+	}
+
+	result := tool.Execute(context.Background(), map[string]any{
+		"command": `sh gtnh_tasks status-update 14 "Quad steam purifier built; waiting on 4 LV heaters and 1 LV gas turbine."`,
+	})
+	if !result.IsError {
+		t.Fatalf("expected command to be blocked by custom deny pattern")
+	}
+	if !strings.Contains(result.ForLLM, `matched ";"`) {
+		t.Fatalf("expected matched token in message, got: %s", result.ForLLM)
+	}
+	if !strings.Contains(strings.ToLower(result.ForLLM), "reword") {
+		t.Fatalf("expected retry guidance in message, got: %s", result.ForLLM)
+	}
+}
