@@ -362,6 +363,23 @@ func (t *ExecTool) guardCommand(command, cwd string) string {
 	return ""
 }
 
+func (t *ExecTool) dangerousPatternMessage(pattern *regexp.Regexp, command, lower string) string {
+	match := pattern.FindString(command)
+	if match == "" {
+		match = pattern.FindString(lower)
+	}
+	if match == "" {
+		match = pattern.String()
+	}
+	if len(match) > 32 {
+		match = match[:32] + "..."
+	}
+	return fmt.Sprintf(
+		"Command blocked by safety guard (dangerous pattern detected: matched %s; reword the command to avoid shell operators or control characters in arguments and retry)",
+		strconv.QuoteToASCII(match),
+	)
+}
+
 func (t *ExecTool) SetTimeout(timeout time.Duration) {
 	t.timeout = timeout
 }
